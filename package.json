{
  "name": "monthly-cost-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "php -S 0.0.0.0:3006 api/router.php",
    "dev:all": "concurrently -n \"frontend,backend\" -c \"cyan,yellow\" \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc && vite build",
    "start": "php -S 0.0.0.0:${PORT:-3006} api/router.php"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  }
}
